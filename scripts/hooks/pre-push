#!/bin/bash
#
# Pre-push hook for WeatherApp
# プッシュ前に実行されるテスト
#

set -e

echo "🚀 Running pre-push checks..."

# リモートとブランチ情報を取得
remote="$1"
url="$2"

# ====================
# 1. Run Full Test Suite
# ====================
echo "🧪 Running tests..."

if swift test; then
    echo "✅ All tests passed"
else
    echo "❌ Tests failed. Push aborted."
    exit 1
fi

# ====================
# 2. Protected Branch Check
# ====================
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
PROTECTED_BRANCHES=("main" "master" "release" "production")

for branch in "${PROTECTED_BRANCHES[@]}"; do
    if [ "$CURRENT_BRANCH" = "$branch" ]; then
        echo "⚠️  Warning: Pushing directly to protected branch '$branch'"
        echo "   Consider using a pull request instead."

        read -p "   Continue anyway? (y/N) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "❌ Push aborted."
            exit 1
        fi
    fi
done

# ====================
# 3. Force Push Detection
# ====================
while read local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
        # リモートに存在するコミットがローカルに含まれているか確認
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            echo "⚠️  Warning: Force push detected"
            echo "   Remote ref: $remote_ref"
            echo "   This may overwrite commits on the remote."

            read -p "   Continue with force push? (y/N) " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo "❌ Push aborted."
                exit 1
            fi
        fi
    fi
done

# ====================
# 4. Build Release Check
# ====================
echo "📦 Building release configuration..."

if swift build -c release 2>/dev/null; then
    echo "✅ Release build succeeded"
else
    echo "⚠️  Release build failed (continuing anyway)"
fi

# ====================
# 5. Documentation Check
# ====================
echo "📚 Checking documentation..."

# 公開APIにドキュメントがあるか簡易チェック
PUBLIC_UNDOCUMENTED=$(grep -r "public func\|public var\|public class\|public struct\|public enum" Sources/ 2>/dev/null | grep -v "///" | wc -l || echo "0")

if [ "$PUBLIC_UNDOCUMENTED" -gt 10 ]; then
    echo "ℹ️  Found $PUBLIC_UNDOCUMENTED public declarations that may need documentation"
fi

echo ""
echo "✅ All pre-push checks passed!"
echo ""
